# Database (PostgreSQL + pgvector for 6-digit HS corpus RAG)
DATABASE_URL=
DIRECT_DATABASE_URL=

# Google Gemini API (@google/genai)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004
CAPTIONING_MODEL=gemini-2.5-flash

# HS RAG Confidence & Candidate Thresholds
CONFIDENCE_FLOOR=0.60
HIGH_CONFIDENCE_MARGIN=0.15
CANDIDATE_MIN_SCORE=0.60
MAX_MEDIUM_CANDIDATES=3
RETRIEVAL_TOP_K=5

# Regulatory Metadata & Disclaimers
VERIFIED_DATE=2026-10-01
NEXT_PUBLIC_VERIFIED_DATE=2026-10-01

# Application URL
NEXT_PUBLIC_APP_URL=https://euaipass.com

# Monetization (Google AdSense & EU Consent Mode v2)
# Leave NEXT_PUBLIC_ADSENSE_CLIENT empty in dev/test to suppress ad slots
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_CMP_ENABLED=true

# Abuse & Cost Control (Rate Limiter, Daily Cap & Bot Check)
RATE_LIMIT_PER_HOUR=10
GLOBAL_DAILY_SCAN_CAP=500
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
